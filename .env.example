# Copy to .env (git-ignored) and fill in for local runs. In production these are
# Heroku config vars; the JDBC_DATABASE_* ones are set by the Heroku Postgres add-on.
JDBC_DATABASE_URL=jdbc:postgresql://<host>:5432/<database>?sslmode=require
JDBC_DATABASE_USERNAME=
JDBC_DATABASE_PASSWORD=
TMDB_API_KEY=
OMDB_API_KEY=
MAGIC_EMAIL_IMAP_PASSWORD=
MAGIC_EMAIL_SMTP_PASSWORD=
WEB_MAIL_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
